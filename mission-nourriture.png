:{\"name\":\"4290031608\",\"rule_id\":\"3ZFkSu8MibYrruegy7huDD:100.00:1\",\"secondary_exposures\":[],\"version\":89,\"id_type\":\"userID\",\"value\":true}},\"dynamic_configs\":{\"24353602\":{\"name\":\"24353602\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"de\":{\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"business_claim\":{\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"workspace_admin\":{\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\",\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\"},\"default\":{\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Entdecke ChatGPT Business\"},\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"personal_upsell\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"}},\"email_selectors\":{\"parameter\":\"for\",\"personal_upsell\":\"personal\",\"business_claim\":\"workspace\"},\"fr\":{\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"workspace_member\":{\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\",\"headline\":\"ChatGPT Business\"},\"workspace_admin\":{\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\",\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\"},\"business_claim\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\"},\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"workspace_owner\":{\"headline\":\"Consultez les avantages de votre espace de travail\",\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"}},\"en\":{\"business_claim\":{\"body\":\"Sign in to the account you use for your Business workspace.\",\"headline\":\"Explore workspace ad credits\"},\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"workspace_owner\":{\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\",\"headline\":\"Check your workspace benefits\"},\"workspace_member\":{\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\",\"headline\":\"ChatGPT Business\"},\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"workspace\":{\"body\":\"A workspace owner can check Benefits for available offers.\",\"headline\":\"Explore workspace ad credits\"},\"personal\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\"},\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"}}},\"is_device_based\":false,\"passed\":false},\"43735283\":{\"name\":\"43735283\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4076966226\",\"gateValue\":\"true\",\"ruleID\":\"3Qrg0sazMu3KFYQ5vbybKp:100.00:12\"},{\"gate\":\"4050156621\",\"gateValue\":\"false\",\"ruleID\":\"2c98b9S92oM5CxuRO3E85I\"}],\"version\":42,\"id_type\":\"userID\",\"value\":{\"text_messaging_enabled\":\"disabled\",\"sentinel_timeout_ms\":250},\"is_device_based\":false,\"passed\":false},\"54108957\":{\"name\":\"54108957\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"done_prompt\":\"Your owner assigned you a Page checkbox.\\nThe checkbox is already complete. Record the assignment without starting new work.\",\"open_prompt\":\"Your owner assigned you a Page checkbox.\\nCarry out the checkbox wording as your owner's request. Use the linked Page block for context if needed. When the task is complete, check off the assigned checkbox on the linked Page.\"},\"is_device_based\":false,\"passed\":false},\"71832722\":{\"name\":\"71832722\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"ht