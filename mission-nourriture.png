fic-research\"}},\"is_device_based\":false,\"passed\":false},\"3745082431\":{\"name\":\"3745082431\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3793778233\":{\"name\":\"3793778233\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"hover_drop_shadow_enabled\":false,\"first_month_free_checkout_summary_enabled\":false,\"subscribe_button_color\":\"primary\",\"shimmer_enabled\":false,\"free_trial_button_text\":\"default\",\"remove_first_month_free_summary_tax_line\":false,\"subscribe_button_subtext\":false,\"show_lock_icon\":false,\"subscribe_button_text\":\"default\",\"heading_variant\":\"control\",\"billing_period_clarity_enabled\":false,\"variant\":\"control\"},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"variant\"],\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3808083031\":{\"name\":\"3808083031\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":22,\"id_type\":\"userID\",\"value\":{\"default\":{\"en\":{\"title\":\"Connect {pluginName}\",\"description\":[],\"disclaimer\":[[\"ChatGPT may share relevant chats and memories with this app to support interactions with it. {pluginName}’s use of this data is subject to their \",{\"text\":\"terms\",\"url\":\"{termsOfServiceUrl}\"},\" and \",{\"text\":\"privacy policy\",\"url\":\"{privacyPolicyUrl}\"},\". \",{\"text\":\"Learn more\",\"url\":\"https://help.openai.com/en/articles/11487775-apps-in-chatgpt\"},\".\"]],\"connectLabel\":\"Connect {pluginName}\"}},\"plugins\":{\"plugin_asdk_app_695bfc98071c8191bac7bc479aa27de7\":{\"en\":{\"title\":\"Connect Box\",\"disclaimer\":[[\"ChatGPT may share relevant chats and memories with this app to support interactions with it. Box’s use of this data is subject to their \",{\"text\":\"terms\",\"url\":\"https://www.